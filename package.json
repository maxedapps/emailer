{
  "name": "emailer",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "emailer": "node --env-file-if-exists=.env apps/cli/src/main.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --project integration",
    "check:imports": "node --input-type=module -e 'await import(\"alchemy\"); await import(\"alchemy/AWS\"); await import(\"alchemy/Cloudflare\"); await import(\"@effect/platform-node/NodeRuntime\")'",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test && pnpm check:imports"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
