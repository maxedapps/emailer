# Emailer configuration keys. This file documents names only and contains no
# usable secrets. Real values belong in an untracked .env / .env.test file.

# Shared bearer credential for every HTTP route: 32 random bytes, base64url
# encoded (43 characters). Generate one per stage, for example with
#   node -e 'import("node:crypto").then(c => console.log(c.randomBytes(32).toString("base64url")))'
EMAILER_API_TOKEN=

# The verified SES sending identity, e.g. mail.example.com. Both stacks read
# this key and must hold the same value. Never change it for EmailerSending:
# the identity name is the prop whose change plans a replacement, which creates
# a new identity and leaves the old one retained but untracked.
EMAILER_SENDER_IDENTITY=

# The From address. It must be an address at EMAILER_SENDER_IDENTITY. The
# domain does not need a mailbox, because nothing replies to it.
EMAILER_FROM_EMAIL=

# Optional positive integer daily cap used by the dispatcher.
EMAILER_DAILY_SEND_CEILING=

# Optional email that receives alarm notifications. SNS sends one confirmation
# mail per stage; leave unset on throwaway stages.
EMAILER_ALERT_EMAIL=

# The physical postal address rendered into every message footer. CAN-SPAM
# requires one in commercial mail to US recipients, and an empty value fails
# the function at construction rather than sending non-compliant mail. The
# value below is a placeholder; a real address is required before real sending.
EMAILER_POSTAL_ADDRESS=Example GmbH, Example Street 1, 12345 Example City, Germany

# CLI only: the deployed Function URL, taken from the stack output.
EMAILER_API_URL=

# Integration tests only: the physical name of the deployed test table, read
# from the deployment's resource inventory.
EMAILER_TEST_TABLE_NAME=

# Integration tests only: the DispatchFailures dead-letter queue URL.
EMAILER_TEST_DISPATCH_FAILURES_QUEUE_URL=

# Integration tests only: the dispatcher function name, copied from the deploy
# inventory the way EMAILER_TEST_TABLE_NAME is (`emailer-<stage>-dispatcher`).
# The log group is `/aws/lambda/<this name>`; do not set a separate log-group key.
EMAILER_TEST_DISPATCHER_FUNCTION_NAME=

# Integration tests only: the physical name of the deployed SetBounceRate
# alarm, copied from the deploy inventory like EMAILER_TEST_TABLE_NAME.
EMAILER_TEST_SET_BOUNCE_ALARM=

# Integration tests only, both copied OUT of the deployment the way
# EMAILER_TEST_TABLE_NAME is. The functions are configured from the stack, not
# from here: the URL is an output of the unsubscribe function and the secret is
# minted by Alchemy.Random and lives in Alchemy state. The suite needs both to
# mint a valid token and drive the endpoint.
EMAILER_UNSUBSCRIBE_URL=
EMAILER_UNSUBSCRIBE_SECRET=

# Deployment target. Alchemy reads these; they are never guessed. Leave
# AWS_PROFILE unset while running the integration suite with exported
# credentials, because it would steer the SDK back to the SSO chain.
AWS_PROFILE=
AWS_REGION=
