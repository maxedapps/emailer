# Emailer configuration keys. This file documents names only and contains no
# usable secrets. Real values belong in untracked .env.prod / .env.test files.

# Shared bearer credential for every HTTP route: 32 random bytes, base64url
# encoded (43 characters). Generate one per stage, for example with
#   node -e 'import("node:crypto").then(c => console.log(c.randomBytes(32).toString("base64url")))'
EMAILER_API_TOKEN=

# The verified SES sending identity, e.g. mail.example.com. Both stacks read
# this key and must hold the same value. Never change it for EmailerSending:
# the identity name is the prop whose change plans a replacement, which creates
# a new identity and leaves the old one retained but untracked.
EMAILER_SENDER_IDENTITY=

# The From address. It must be an address at EMAILER_SENDER_IDENTITY. The
# domain does not need a mailbox, because nothing replies to it.
EMAILER_FROM_EMAIL=

# Optional. The name recipients see beside the From address, e.g. Example News.
# At most 45 UTF-8 bytes, without quotes, backslashes or line breaks. Leave
# empty to send from the bare address.
EMAILER_FROM_NAME=

# Optional. Lets the identity stack publish the identity's DNS records itself:
# "route53" (the public hosted zone in the same AWS account) or "cloudflare"
# (the enclosing zone; the Alchemy profile needs Cloudflare credentials).
# Leave empty to publish them by hand. Route 53 overwrites an existing record
# with the same name and type without warning.
EMAILER_DNS=

# Optional, only with EMAILER_DNS: also publish a p=none DMARC record that
# reports to this address. Set it only if the domain has no DMARC record yet;
# a name can hold only one. An address on another domain still needs its
# report authorization record published by hand.
EMAILER_DMARC_REPORT_EMAIL=

# Optional positive integer daily cap used by the dispatcher.
EMAILER_DAILY_SEND_CEILING=

# Optional email that receives alarm notifications. SNS sends one confirmation
# mail per stage; leave unset on throwaway stages.
EMAILER_ALERT_EMAIL=

# The physical postal address rendered into every message footer. CAN-SPAM
# requires one in commercial mail to US recipients, and an empty value fails
# the function at construction rather than sending non-compliant mail.
# Example: Example GmbH, Example Street 1, 12345 Example City, Germany
EMAILER_POSTAL_ADDRESS=

# CLI only: the deployed Function URL, taken from the stack output.
EMAILER_API_URL=

# Deployment target. Alchemy reads these; they are never guessed. Leave
# AWS_PROFILE unset while running the integration suite with exported
# credentials, because it would steer the SDK back to the SSO chain.
AWS_PROFILE=
AWS_REGION=
